<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SupportOS - N1 Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #000000; height: 100vh; overflow: hidden; display: flex; color: white; }
        .sidebar { width: 280px; background: #000000; color: white; display: flex; flex-direction: column; padding: 40px 24px; flex-shrink: 0; }
        .nav-item { padding: 14px 18px; border-radius: 14px; margin-bottom: 8px; cursor: pointer; transition: 0.3s; color: #94a3b8; display: flex; align-items: center; gap: 12px; font-weight: 600; }
        .nav-item.active { background: #3b82f6; color: white; }
        .main-content { flex: 1; display: flex; flex-direction: column; background: white; border-radius: 32px 0 0 32px; color: #0f172a; overflow: hidden; }
        .selector { display: flex; gap: 40px; border-bottom: 1px solid #f1f5f9; padding: 0 40px; }
        .selector button { padding: 20px 0; font-weight: 800; color: #94a3b8; border-bottom: 3px solid transparent; }
        .selector button.active { color: #3b82f6; border-bottom-color: #3b82f6; }
        .menu { display: flex; gap: 8px; padding: 20px 40px; flex-wrap: wrap; }
        .menu button { padding: 10px 16px; border-radius: 12px; background: #f1f5f9; font-size: 12px; font-weight: 700; color: #64748b; }
        .menu button.active { background: #00c896; color: white; }
        .block { background: #fff; border-radius: 20px; padding: 24px; border: 1px solid #e2e8f0; }
        .tag { display: inline-block; padding: 4px 12px; border-radius: 99px; font-size: 10px; font-weight: 800; text-transform: uppercase; margin-bottom: 12px; }
        .btn { width: 100%; padding: 14px; border-radius: 16px; color: white; font-weight: 800; cursor: pointer; border: none; margin-top: 10px; }
    </style>
</head>
<body>

<aside class="sidebar">
    <div class="flex items-center gap-3 mb-10">
        <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center"><i class="fas fa-network-wired text-white"></i></div>
        <span class="text-xl font-extrabold">Support<span class="text-blue-400">OS</span></span>
    </div>
    
    <div id="navOffline" class="nav-item active" onclick="cambiarProceso('offline', 'n1')">
        <i class="fas fa-power-off"></i> Router Offline
    </div>
    <div id="navN2" class="nav-item" onclick="cambiarProceso('n2', 'n2')">
        <i class="fas fa-user-shield"></i> Soporte N2
    </div>
</aside>

<main class="main-content">
    <div class="selector">
        <button id="btnPhantom" class="active" onclick="setEquipo('phantom')">PHANTOM</button>
        <button id="btnVilo" onclick="setEquipo('vilo')">ROUTER VILO</button>
    </div>
    <div id="pillsContainer" class="menu"></div>
    <div class="flex-1 p-10 overflow-y-auto">
        <div id="app"></div>
    </div>
</main>

<script>
// DATOS (He simplificado para que no falle, rellena según necesites)
const DATA = {
    offline: {
        phantom: [
            { pill: "Validación", title: "🔍 Router Offline", tag: "Sistema", html: "Ejecutar CPE Doctor..." },
            { pill: "Usuario", title: "🔌 Validación Física", tag: "Cliente", html: "Revisar cables..." },
            { pill: "Resultado", title: "✅ Fin", tag: "Resultado", html: "Escalar si no funciona." }
        ],
        vilo: [{ pill: "Inicio", title: "Vilo Offline", tag: "Sistema", html: "Reiniciar equipo." }]
    },
    n2: {
        phantom: [
            { pill: "Herramientas", title: "🛠️ N2 Análisis", tag: "Técnico", html: "Revisar EDGE/Radius." },
            { pill: "Resultado", title: "🚩 Escalamiento", tag: "Resultado", html: "Enviar a terreno." }
        ]
    }
};

let procesoActual = 'offline';
let equipoActual = 'phantom';
let pasoActual = 0;
let miArea = 'n1'; // Detecta si es N1 o N2

function cambiarProceso(proc, area) {
    procesoActual = proc;
    miArea = area;
    pasoActual = 0;
    document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
    event.currentTarget.classList.add('active');
    render();
}

function setEquipo(eq) {
    equipoActual = eq;
    pasoActual = 0;
    document.getElementById('btnPhantom').classList.toggle('active', eq === 'phantom');
    document.getElementById('btnVilo').classList.toggle('active', eq === 'vilo');
    render();
}

function render() {
    const pasos = DATA[procesoActual][equipoActual] || [];
    const dataActual = pasos[pasoActual];
    
    // LÓGICA DE FILTRADO (Como en tu imagen 3 y 4)
    const pasosFiltrados = pasos.filter(p => {
        if (miArea === 'n2') {
            return p.pill === "Herramientas" || p.pill === "Resultado" || p.pill === "N2";
        }
        return p.pill !== "Herramientas" && p.pill !== "N2";
    });

    // Dibujar Pills
    document.getElementById('pillsContainer').innerHTML = pasosFiltrados.map(p => {
        const realIndex = pasos.indexOf(p);
        return `<button class="${realIndex === pasoActual ? 'active' : ''}" onclick="pasoActual=${realIndex}; render()">${p.pill}</button>`;
    }).join('');

    // Dibujar Contenido (Como en tu imagen 2)
    const isN2 = miArea === 'n2';
    if (!dataActual) return;

    document.getElementById('app').innerHTML = `
        <div class="animate-in">
            <div class="tag ${isN2 ? 'bg-orange-100 text-orange-700' : 'bg-blue-100 text-blue-700'}">
                ${isN2 ? 'ESPECIALIZADO N2' : 'DIAGNÓSTICO N1'} - ${dataActual.tag}
            </div>
            <h3 class="text-2xl font-bold mb-4">${dataActual.title}</h3>
            <div class="block mb-6">${dataActual.html}</div>
            
            <button class="btn" style="background: ${isN2 ? '#f97316' : '#3b82f6'}" onclick="siguiente()">
                Continuar Paso <i class="fas fa-arrow-right ml-2"></i>
            </button>
        </div>
    `;
}

function siguiente() {
    const pasos = DATA[procesoActual][equipoActual];
    if (pasoActual < pasos.length - 1) {
        pasoActual++;
        render();
    }
}

// Primera carga
render();
</script>
</body>
</html>
